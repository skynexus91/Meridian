# Never commit .env. A TomTom key is required to display the interactive map.
PORT=3001
HOST=127.0.0.1
# Set only when deployed behind a reverse proxy. Use its address or CIDR.
# TRUST_PROXY=127.0.0.1/32
# AISSTREAM_API_KEY=
# OPEN_METEO_API_KEY=
# TomTom key with Orbis Map Display, Routing and Traffic access. Server-side only.
# TOMTOM_API_KEY=
# ADMIN_TOKEN=choose-a-long-random-local-token
# Paid-data and publishing are not enabled automatically.

VISUAL_CROSSING_API_KEY=

# Optional HTTP-referrer-restricted browser key for Maps JavaScript API. Rebuild after setting.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Optional local Whisper service. Browser voice search works without Python.
# Enable only after installing faster-whisper and provisioning its model/runtime.
# VOICE_STT_ENABLED=1
# VOICE_STT_PYTHON=python
# VOICE_STT_MODEL=small

# Optional voice ICE infrastructure. Configure TURN with its server-side REST shared secret.
# VOICE_STUN_URL=stun:stun.example.net:3478
# VOICE_TURN_URL=turns:turn.example.net:5349
# VOICE_TURN_SECRET=
# Set a unique random secret of at least 32 characters to enable live drive sharing.
# DRIVE_SHARE_SECRET=
# Optional private OSRM endpoint built with server/peak-car.lua.
# OSRM_PEAK_URL=http://127.0.0.1:5001
